# Domínio público da aplicação (o Caddy emite certificado HTTPS automaticamente)
DOMAIN=termofeed.exemplo.com

# Imagem do back-end em Go
BACK_IMAGE=ghcr.io/termofeed/termofeed-back:latest

# E-mail de contato para notificações da Let's Encrypt / ZeroSSL
ACME_EMAIL=voce@exemplo.com

# URL base da API para desenvolvimento (padrão em prod é /api/v1 pela mesma origem)
VITE_API_URL=/api/v1
